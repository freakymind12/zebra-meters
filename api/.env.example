# Koneksi MySQL — salin ke .env lalu sesuaikan jika perlu.
# (Bun otomatis memuat file .env)
DB_HOST=localhost
DB_PORT=3306
DB_USER=zebrameter
DB_PASSWORD=zebrameter_secret
DB_NAME=zebrameter_db

# API key opsional.
# Jika DIISI, endpoint POST /api/printer-meter akan mewajibkan
# header  X-API-Key: <nilai>  (lihat clients/config.json -> api.apiKey).
# Jika DIKOSONGKAN / tidak didefinisikan, endpoint terbuka tanpa auth.
API_KEY=
