# ZebraMeter — DEVELOPMENT
# Salin file ini ke .env. Bun memuat .env otomatis.
NODE_ENV=development
PORT=3000

# Koneksi API native ke MySQL Docker yang dipublikasikan di localhost.
DB_HOST=localhost
DB_PORT=3306
DB_USER=zebrameter
DB_PASSWORD=zebrameter_secret
DB_NAME=zebrameter_db

# Kosong = endpoint POST terbuka di development.
# Jika diisi, client wajib mengirim header X-API-Key dengan nilai yang sama.
API_KEY=
