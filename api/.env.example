# ZebraMeter API — DEVELOPMENT
# Salin ke `.env` (sefolder dengan package.json), lalu sesuaikan bila perlu.
# Bun otomatis memuat `.env` saat `bun run dev` / `bun run start`.

NODE_ENV=development

# API — port server (Bun auto-serve)
PORT=3000

# Database MySQL (development via `bun run dev:db`)
DB_HOST=localhost
DB_PORT=3306
DB_USER=zebrameter
DB_PASSWORD=zebrameter_secret
DB_NAME=zebrameter_db

# Rate limiting (opsional)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
