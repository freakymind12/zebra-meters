# Dependencies (di-install di dalam image)
node_modules

# Secrets — jangan masuk build context/image
.env
.env.*
!.env.example
!.env.production.example

# Runtime logs
*.log

# Diagnostics sementara (jangan ikut ke image/build context)
*.tmp
.tlsdiag.js

# Drizzle migration files TIDAK di-exclude — dibutuhkan di dalam
# image agar `drizzle-kit migrate` dapat berjalan saat container start.

# Docker / compose files (tidak perlu jadi konteks build)
Dockerfile
.dockerignore
docker-compose.yaml
docker-compose.prod.yaml

# VCS
.git
.gitignore

# Editor / OS
.vscode
.idea
.DS_Store
