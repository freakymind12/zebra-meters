# ZebraMeter — PRODUCTION (VM)
# Salin ke .env.production, lalu ganti seluruh placeholder rahasia.
# File .env.production di-ignore oleh Git dan tidak boleh di-commit.

# Dipakai oleh `bun run start:prod`; Compose juga menetapkan ini di container.
NODE_ENV=production

API_PORT=3000
PMA_PORT=8080
TZ=Asia/Jakarta

# Biarkan kosong pada template. Compose menolak start sampai Anda mengisinya.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=zebrameter_db
MYSQL_USER=zebrameter
MYSQL_PASSWORD=

# Wajib di production. Gunakan nilai acak panjang (minimal 32 karakter).
API_KEY=
