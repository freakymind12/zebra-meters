# ZebraMeter API — PRODUCTION (VM)
# Salin ke .env.production, lalu isi seluruh placeholder rahasia.
# File .env.production di-ignore oleh Git dan tidak boleh di-commit.
#
# Deploy:
#   docker compose --env-file .env.production -f docker-compose.yaml up -d --build

NODE_ENV=production

API_PORT=3000
PMA_PORT=8080
TZ=Asia/Jakarta

# Biarkan kosong pada template. Compose menolak start sampai Anda mengisinya.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=zebrameter_db
MYSQL_USER=zebrameter
MYSQL_PASSWORD=